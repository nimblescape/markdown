{
  "name": "nimblescape-markdown",
  "private": true,
  "description": "The npm workspaces of nimblescape Markdown, general libraries for text documents, Markdown first, for the web and for VS Code: one npm package for each part in packages/. This root package is not published.",
  "license": "MIT",
  "author": {
    "name": "nimblescape e.U.",
    "url": "https://nimblescape.com"
  },
  "homepage": "https://github.com/nimblescape/markdown#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nimblescape/markdown.git"
  },
  "bugs": {
    "url": "https://github.com/nimblescape/markdown/issues"
  },
  "type": "module",
  "workspaces": [
    "packages/markdowntext",
    "packages/markdowneditor",
    "packages/markdownvscode"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "demo": "node esbuild.mjs --serve",
    "demo:vscode": "node esbuild.mjs --vscode",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "licenses": "node scripts/check-licenses.mjs",
    "pack": "npm pack --workspaces"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/vscode": "~1.125.0",
    "commonmark-spec": "^0.31.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
