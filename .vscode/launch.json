// Runs the example extension of nimblescape Markdown in a new window of VS Code (CONTRIBUTING.md, "The example
// extension for VS Code"). The task builds it first.
{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Example extension",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/demo/vscode"],
      "preLaunchTask": "Build the example extension"
    }
  ]
}
