{
  "name": "@nimblescape/markdowntext",
  "version": "0.1.0",
  "description": "The source of nimblescape Markdown: the text of a file without a view, its changes as text patches with their origin, the selections of its editors and the merge of two changes at the same time; and the front matter in YAML, TOML or JSON, whose edits keep the comments, the order and the quotes of the other keys, with the check against a JSON schema.",
  "license": "MIT",
  "author": {
    "name": "nimblescape e.U.",
    "url": "https://nimblescape.com"
  },
  "homepage": "https://github.com/nimblescape/markdown/tree/main/packages/markdowntext#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nimblescape/markdown.git",
    "directory": "packages/markdowntext"
  },
  "bugs": {
    "url": "https://github.com/nimblescape/markdown/issues"
  },
  "keywords": [
    "markdown",
    "front matter",
    "yaml",
    "toml",
    "json schema"
  ],
  "type": "module",
  "exports": {
    ".": {
      "nimblescape-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/*.js",
    "dist/**/*.d.ts"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node ../../esbuild.mjs --production && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.6",
    "@decimalturn/toml-patch": "^3.3.2",
    "diff": "^9.0.0",
    "jsonc-parser": "^3.3.1",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=22"
  }
}
