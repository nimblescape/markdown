{
  "name": "@nimblescape/markdownai",
  "version": "0.1.0",
  "description": "The AI of nimblescape Markdown without a view: the provider API that makes any AI pluggable, the context of the document for the AI, the tool with which the AI proposes a change of the text, the loop of a chat with its tools, and the connection of a provider in another process, for example in the extension host of VS Code, so that the API key never reaches the page.",
  "license": "MIT",
  "author": {
    "name": "nimblescape e.U.",
    "url": "https://nimblescape.com"
  },
  "homepage": "https://github.com/nimblescape/markdown/tree/main/packages/markdownai#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nimblescape/markdown.git",
    "directory": "packages/markdownai"
  },
  "bugs": {
    "url": "https://github.com/nimblescape/markdown/issues"
  },
  "keywords": [
    "markdown",
    "ai",
    "chat",
    "tool use"
  ],
  "type": "module",
  "exports": {
    ".": {
      "nimblescape-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/*.js",
    "dist/**/*.d.ts"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node ../../esbuild.mjs --production && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@nimblescape/markdowntext": "0.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
